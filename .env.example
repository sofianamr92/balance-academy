# ==============================================================================
# BALANCE ACADEMY — Environment Configuration Template
# Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# Application
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# Local Server Signing Secrets (Generate strong 32+ byte hex values in production)
SESSION_SECRET="replace-with-32-byte-random-hex-session-secret"
VIDEO_TOKEN_SECRET="replace-with-32-byte-random-hex-video-signing-secret"

# Cloud SQL (PostgreSQL) — Injected automatically in AI Studio runtime
SQL_HOST="/cloudsql/project:region:instance"
SQL_DB_NAME="balance_academy"
SQL_USER="app_user"
SQL_PASSWORD="replace-with-app-user-password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="replace-with-admin-password"

# Protected Video Storage & Delivery (Cloudflare R2 + Workers)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_PRIVATE_BUCKET_NAME="balance-academy-private-videos"
CLOUDFLARE_VIDEO_WORKER_URL="https://video.balance.academy"
CLOUDFLARE_WORKER_SIGNING_SECRET="replace-with-shared-worker-hmac-secret"

# Optional Email Notifications (Resend / SMTP)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS="noreply@balance.academy"

# Optional AI Studio runtime variable
GEMINI_API_KEY="MY_GEMINI_API_KEY"
